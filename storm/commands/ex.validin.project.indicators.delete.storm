// Remove indicators from a Validin project and clean up (refs) edges
init {
    if $cmdopts.debug { $lib.debug = $lib.true }
    $api = $lib.import(ex.validin.api, debug=$lib.debug)
    $privsep = $lib.import(ex.validin.privsep, debug=$lib.debug)
}

$api_key_set = $privsep.getValidinAPIKey()

if ($api_key_set != $lib.false) {

    // Resolve project identifier (name or GUID) to get both project GUID and Validin GUID
    ($success, $project_guid, $validin_guid) = $privsep.resolveProjectIdentifier($cmdopts.project_identifier)

    if (not $success) {
        $lib.warn(`Project not found: {$cmdopts.project_identifier}. Run 'ex.validin.project.list' to sync projects first.`)
        return()
    }

    // Initialize payload structure
    $payload = ({
        "types": ({
            "dom": ([]),
            "ip": ([]),
            "hash": ([]),
            "raw": ([])
        })
    })

    $indicator_value = $node.repr()

    switch $node.form() {
        "inet:fqdn": {
            $payload.types.dom.append($indicator_value)
        }
        ("inet:ipv4", "inet:ipv6"): {
            $payload.types.ip.append($indicator_value)
        }
        ("hash:md5", "hash:sha1", "hash:sha256"): {
            $payload.types.hash.append($indicator_value)
        }
        *: {
            $lib.warn("Unsupported form for indicator deletion: {f}", f=$node.form())
            return()
        }
    }

    $privsep.debugPrint("Delete", `Starting delete {$node.form()}={$indicator_value}`)

    $result = $api.deleteProjectIndicators($validin_guid, $payload)
    if ($result) {
        [ <(refs)- { proj:project=$project_guid } ]
        $privsep.debugPrint("Delete", `Successfully deleted {$node.form()}={$indicator_value}`)
    } else {
        $lib.warn(`Failed to delete indicator from project`)
    }

} else {
    $lib.exit("Validin API key not set and is needed to use this function, please run 'ex.validin.setup.apikey' first")
} 