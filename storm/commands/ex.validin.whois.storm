// Retrieve domain registration history from Validin
// Creates inet:whois:rec nodes with temporal data
init {
    if $cmdopts.debug { $lib.debug = $lib.true }
    $api = $lib.import(ex.validin.api, debug=$lib.debug)
    $privsep = $lib.import(ex.validin.privsep, debug=$lib.debug)
}

$api_key_set = $privsep.getValidinAPIKey()

if ($api_key_set != $lib.false) {
    // Pivot to zone (apex domain) for WHOIS lookup
    :zone -> inet:fqdn {
        $zone_domain = $node.repr()
        $privsep.debugPrint("WHOIS", `Getting registration history for zone: {$zone_domain}`)

        $data = $api.getDomainRegHistory($zone_domain)

        if ($data) {
            divert $cmdopts.yield $privsep.emitDomainRegHistory($data)
        }
    }
} else {
    $lib.exit("Validin API key not set and is needed to use this function, please run 'ex.validin.setup.apikey' first")
}
