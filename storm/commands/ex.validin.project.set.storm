// Set active Validin project by name or GUID for indicator operations
init {
    if $cmdopts.debug { $lib.debug = $lib.true }
    $privsep = $lib.import(ex.validin.privsep, debug=$lib.debug)
}

$privsep.debugPrint("Set", `Starting set active project {$cmdopts.project_identifier}`)

// Resolve project identifier to get project GUID
($success, $project_guid, $validin_guid) = $privsep.resolveProjectIdentifier($cmdopts.project_identifier)

if (not $success) {
    $lib.warn(`Project not found: {$cmdopts.project_identifier}. Run 'ex.validin.project.list' to sync projects first.`)
    return()
}

$result = $privsep.setValidinActiveProject($project_guid, $cmdopts.self)

if ($result) {
    $scope = "globally"
    if ($cmdopts.self) {
        $scope = "for your user"
    }

    proj:project=$project_guid {
        $project_name = $node.props.get("name")
        if ($project_name = $lib.null) {
            $project_name = "Unknown"
        }
        $lib.print(`Successfully set active Validin project {$scope}: {$project_name} ({$project_guid})`)
    }
} else {
    $lib.warn("Failed to set active project. Ensure the project exists in Synapse.")
}