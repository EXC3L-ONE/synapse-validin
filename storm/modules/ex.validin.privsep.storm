/*
    Validin privilege separation layer.

    Handles authentication, HTTP execution, and response parsing.
    Creates Synapse nodes with proper relationships and meta source tagging.
*/

// =============================================================================
// CORE UTILITIES - Meta source, debugging, configuration
// =============================================================================

function getMetaSource() {
    [ meta:source=$lib.guid("validin", "ex", "powerup") :name="validin" ]
    return($node)
}

function debugPrint(operation_type, details) {
    if $lib.debug {
        $lib.print(`{$operation_type}: {$details}`)
    }
}

function setValidinExtendedProps() {

    $validin_prop_list = ([])

    $existing_props = $lib.model.ext.getExtModel().props
    for $prop in $existing_props {
        if ($prop.0 = 'inet:http:request') {
            $validin_prop_list.append($prop.1)
        }
    }

    if (not $validin_prop_list.has('_validin:body_hash')) {
        $propinfo = ({'doc': 'The SHA1 hash of the body observed by Validin'})
        $lib.model.ext.addFormProp(inet:http:request, _validin:body_hash, (hash:sha1, $({})), $propinfo)
    } if (not $validin_prop_list.has('_validin:favicon_hash')) {
        $propinfo = ({'doc': 'The MD5 hash of the favicon observed by Validin'})
        $lib.model.ext.addFormProp(inet:http:request, _validin:favicon_hash, (hash:md5, ({})), $propinfo)
    } if (not $validin_prop_list.has('_validin:class_0_hash')) {
        $propinfo = ({'doc': 'The v0.0 version of the MD5 hash of the HTML classes observed by Validin'})
        $lib.model.ext.addFormProp(inet:http:request, _validin:class_0_hash, (hash:md5, ({})), $propinfo)
    } if (not $validin_prop_list.has('_validin:class_1_hash')) {
        $propinfo = ({'doc': 'The v0.1 version of the MD5 hash of the HTML classes observed by Validin'})
        $lib.model.ext.addFormProp(inet:http:request, _validin:class_1_hash, (hash:md5, ({})), $propinfo)
    } if (not $validin_prop_list.has('_validin:banner_0_hash')) {
        $propinfo = ({'doc': 'The v0.0 version of the MD5 hash of the banners observed by Validin'})
        $lib.model.ext.addFormProp(inet:http:request, _validin:banner_0_hash, (hash:md5, ({})), $propinfo)
    } if (not $validin_prop_list.has('_validin:title')) {
        $propinfo = ({'doc': 'The title of the HTML site observed by Validin'})
        $lib.model.ext.addFormProp(inet:http:request, _validin:title, (str, ({})), $propinfo)
    }

    // Add extended property for proj:project
    $validin_proj_prop_list = ([])
    for $prop in $existing_props {
        if ($prop.0 = 'proj:project') {
            $validin_proj_prop_list.append($prop.1)
        }
    }

    if (not $validin_proj_prop_list.has('_validin:guid')) {
        $propinfo = ({'doc': 'The Validin project GUID'})
        $lib.model.ext.addFormProp(proj:project, _validin:guid, (str, ({})), $propinfo)
    }

    // Add extended properties for inet:fqdn reputation
    $validin_fqdn_prop_list = ([])
    for $prop in $existing_props {
        if ($prop.0 = 'inet:fqdn') {
            $validin_fqdn_prop_list.append($prop.1)
        }
    }

    if (not $validin_fqdn_prop_list.has('_validin:reputation_score')) {
        $propinfo = ({'doc': 'The Validin reputation score (0-10 scale)'})
        $lib.model.ext.addFormProp(inet:fqdn, _validin:reputation_score, (float, ({'min': 0, 'max': 10})), $propinfo)
    } if (not $validin_fqdn_prop_list.has('_validin:reputation_verdict')) {
        $propinfo = ({'doc': 'The Validin reputation verdict (low_risk, suspicious, malicious)'})
        $lib.model.ext.addFormProp(inet:fqdn, _validin:reputation_verdict, (str, ({})), $propinfo)
    }
}

// =============================================================================
// AUTHENTICATION & CONFIGURATION - API keys, hostnames, settings
// =============================================================================

function getValidinAPIKey() {
    // see if the user has their own key set
    $apikey = $lib.user.vars.get("validin:apikey")
    if ($apikey) {
        return($apikey)
    }

    // no user key, check for global
    $apikey = $lib.globals.get("validin:apikey")
    if ($apikey) {
        return($apikey)
    }

    return($lib.false)
}

function setValidinAPIKey(key, self) {
    if ($self) {
        $lib.user.vars.set("validin:apikey", `Bearer {$key}`)
    } else {
        $lib.globals.set("validin:apikey", `Bearer {$key}`)
    }
    return($checkValidinAPIKey())
}

function checkValidinAPIKey() {
    $resp = $makeValidinAPIRequest("ping")

    if ($resp.status = "OK") {
        return($lib.true)
    } else {
        return($lib.false)
    }
}

function setValidinAPIHostname(hostname) {
    ($ok, $hostname_normalised) = $lib.trycast(inet:fqdn, $hostname)
    if ($ok) {
        $lib.globals.set("validin:api-hostname", $hostname)
        return($lib.true)
    } else {
        $lib.warn(`Failed to set Validin API hostname, couldn't normalise value to a domain: {$hostname}`)
        return($lib.false)
    }

}

function getTagPrefix() {
    return($lib.globals.get("ex.validin:tag-prefix", default="rep.validin"))
}

function setTagPrefix(prefix) {
    ($ok, $norm) = $lib.trycast(syn:tag:part, $prefix)
    if (not $ok) {
        $lib.warn(`failed to set tag prefix, invalid value: {$prefix}`)
        return($lib.null)
    }

    $lib.globals.set("ex.validin:tag-prefix", $prefix)
}

// =============================================================================
// HTTP EXECUTION - Authentication, requests, error handling
// =============================================================================

function makeValidinAPIRequest(api_endpoint, method="GET", post_data=$lib.null) {
    $api_hostname = $lib.globals.get("validin:api-hostname", default="api.validin.com")
    $url = `https://{$api_hostname}/api/{$api_endpoint}`

    $debugPrint("HTTP", `Calling API URL: {$url} with method {$method}`)
    if ($post_data) {
        $debugPrint("HTTP", `POST data: {$post_data}`)
    }

    // Handle GET vs POST requests
    if ($method = "POST") {
        $resp = $lib.inet.http.post($url, headers=({"Authorization": $getValidinAPIKey(), "Content-Type": "application/json"}), json=$post_data)
    } else {
        $resp = $lib.inet.http.get($url, headers=({"Authorization": $getValidinAPIKey()}))
    }

    if ($resp.code != 200) {
        $lib.warn(`Validin API {$method} request failed with code {$resp.code}`)
        $debugPrint("HTTP", `Response body: {$resp.body}`)
        return($lib.null)
    }

    $json = $resp.body.json()

    $debugPrint("HTTP", `API Response Code: {$resp.code}`)
    if ($json) {
        $debugPrint("HTTP", "Processing API response data")
        if ($json.indicators) {
            $debugPrint("HTTP", `Indicators found: {$lib.len($json.indicators)}`)
            if ($lib.len($json.indicators) > 0) {
                $debugPrint("HTTP", `First indicator: {$json.indicators.0}`)
            }
        } else {
            $debugPrint("HTTP", "No 'indicators' key in response")
        }
    } else {
        $debugPrint("HTTP", "API response is null/empty")
    }

    return($json)
}

// =============================================================================
// PASSIVE DNS ENRICHMENT - Historical DNS resolution data
// =============================================================================

function parseDomainPDNS(data) {

    $srcnode = $getMetaSource()

    tee {
        // DNS record creation creates both endpoint nodes and linking records
        // Each DNS record type has specific endpoint forms (FQDN+IPv4/IPv6/NS)
        for $dns_a in $data.records.A {
            $first = $lib.time.fromunix($dns_a.first_seen)
            $last = $lib.time.fromunix($dns_a.last_seen)
            [ inet:dns:a=(
                { [ inet:fqdn=$dns_a.key .seen=($first,$last) ] },
                { [ inet:ipv4=$dns_a.value .seen=($first,$last) ] }
            ) .seen=($first,$last) ]
        }

        for $dns_ns in $data.records.NS {
            $first = $lib.time.fromunix($dns_ns.first_seen)
            $last = $lib.time.fromunix($dns_ns.last_seen)
            [ inet:dns:ns=(
                { [ inet:fqdn=$dns_ns.key .seen=($first,$last) ] },
                { [ inet:fqdn=$dns_ns.value .seen=($first,$last) ] }
            ) .seen=($first,$last) ]
        }

        for $dns_aaaa in $data.records.AAAA {
            $first = $lib.time.fromunix($dns_aaaa.first_seen)
            $last = $lib.time.fromunix($dns_aaaa.last_seen)
            [ inet:dns:aaaa=(
                { [ inet:fqdn=$dns_aaaa.key .seen=($first,$last) ] },
                { [ inet:ipv6=$dns_aaaa.value .seen=($first,$last) ] }
            ) .seen=($first,$last) ]
        }

        for $dns_mx in $data.records.MX {
            $first = $lib.time.fromunix($dns_mx.first_seen)
            $last = $lib.time.fromunix($dns_mx.last_seen)
            [ inet:dns:mx=(
                { [ inet:fqdn=$dns_mx.key .seen=($first,$last) ] },
                { [ inet:fqdn=$dns_mx.value .seen=($first,$last) ] }
            ) .seen=($first,$last) ]
        }

        for $dns_txt in $data.records.TXT {
            $first = $lib.time.fromunix($dns_txt.first_seen)
            $last = $lib.time.fromunix($dns_txt.last_seen)
            [ inet:dns:txt=(
                { [ inet:fqdn=$dns_txt.key .seen=($first,$last) ] },
                $dns_txt.value
            ) .seen=($first,$last) ]
        }
    }

    | uniq |
    [<(seen)+ { yield $srcnode }]

}

function parseIpPDNS(data) {

    $srcnode = $getMetaSource()

    // For IP PDNS, key/value are swapped compared to domain PDNS
    for $dns_a in $data.records.A {
        $first = $lib.time.fromunix($dns_a.first_seen)
        $last = $lib.time.fromunix($dns_a.last_seen)
        [ inet:dns:a=(
            { [ inet:fqdn=$dns_a.value .seen=($first, $last) ] },
            { [ inet:ipv4=$dns_a.key .seen=($first, $last) ] }
        ) .seen=($first, $last) ]
    }

    [<(seen)+ { yield $srcnode }]
    | uniq

}

// =============================================================================
// HOST ANALYSIS - Subdomains, HTTP responses, crawl data, JARM fingerprints
// =============================================================================

function parseDomains(data) {

    $srcnode = $getMetaSource()

    for $domain in $data.domains {
        [inet:fqdn=$domain.fqdn]
    }
    | uniq |
    [<(seen)+ { yield $srcnode }]

}

function parseCrawlResponse(data, create_query=$lib.false, query="") {

    $srcnode = $getMetaSource()
    $query_time = $lib.time.now()
    $query_created = $lib.false

    for $crawl in $data.records.crawlr {
        if (not $crawl.value.error) {

            $banners = ([])
            for $banner in $crawl.value.banner_full { if ($banner ~=": ") { $banners.append($banner.split(": ")) }}

            if ($crawl.value.location) { $url = $crawl.value.location }
            elif ($crawl.value.host and $crawl.value.port and $crawl.value.port != 80 and $crawl.value.port != 443) { $url = `{$crawl.value.scheme}://{$crawl.value.host}:{$crawl.value.port}` } 
            elif ($crawl.value.host) { $url = `{$crawl.value.scheme}://{$crawl.value.host}` }
            elif ($crawl.value.ip and $crawl.value.port and $crawl.value.port != 80 and $crawl.value.port != 443 ) { $url = `{$crawl.value.scheme}://{$crawl.value.ip}:{$crawl.value.port}` }
            else { $url = `{$crawl.value.scheme}://{$crawl.value.ip}` }

            [(inet:http:request=("validin", $crawl.key, $crawl.first_seen, $crawl.last_seen)
                :url*unset=$url
                :time*unset=$lib.time.fromunix($crawl.first_seen)
                :server*unset=`tcp://{$crawl.value.ip}:{$crawl.value.port}`
                :response:headers*unset=$banners
                :response:code*unset?=$lib.regex.search(" (\d{3}) ", $crawl.value.start_line).0
                :_validin:body_hash*unset?=$crawl.value.body_hash
                :_validin:favicon_hash*unset?=$crawl.value.favicon_hash
                :_validin:class_0_hash*unset?=$crawl.value.class_0_hash
                :_validin:class_1_hash*unset?=$crawl.value.class_1_hash
                :_validin:banner_0_hash*unset?=$crawl.value.banner_0_hash
                :flow={[inet:flow=("validin", $crawl.key, $crawl.first_seen, $crawl.last_seen, $crawl.value.port, $crawl.value.scheme)
                    :dst*unset=`tcp://{$crawl.value.ip}:{$crawl.value.port}`
                    :dst:handshake*unset=$crawl.value.banner
                    :dst:txbytes*unset=$crawl.value.length
                    :time*unset=$lib.time.fromunix($crawl.first_seen)
                    :dst:ssl:cert?={[crypto:x509:cert=$lib.gen.cryptoX509CertBySha256($crawl.value.cert_fingerprint_sha256) 
                                        :validity:notafter*unset=$crawl.value.cert.not_after
                                        :validity:notbefore*unset=$crawl.value.cert.not_before
                                        :issuer*unset=$crawl.value.cert.issuer.replace("/", " ")
                    ]}
                ]}
            )]

            for $anchor in $crawl.value.ext_links.anchors {
                [+(_validin:anchor)> {[inet:fqdn=$anchor]}]
            }
        }

        if ($crawl.value.cert_details.jarm) {
            { [(inet:ssl:jarmsample=(`tcp://{$crawl.value.ip}:{$crawl.value.port}`, $crawl.value.cert_details.jarm) .seen=($crawl.first_seen, $crawl.last_seen) )] }
        }

    }
    | uniq |
    [<(seen)+ { yield $srcnode }]

    if ($create_query) { 
        if (not $query_created) {
            $query_node = $createQueryNode($query)
            $query_created = $lib.true
        }

        [ <(found)+ { yield $query_node } ]
    }
}

function createQueryNode(query) {
    [it:exec:query=("validin", $lib.time.now(), $query)
                            :text=$query
                            :time=$lib.time.now()
                            :language=validin
                            :synuser=$lib.user.iden
                            :api:url=`https://{$lib.globals.get("validin:api-hostname", default="api.validin.com")}/api/axon/advanced/query`
    ]
    return($node)
}

// =============================================================================
// DOMAIN INTELLIGENCE - WHOIS history, reputation scores, risk tags
// =============================================================================

function selectBestTimestamp(reg) {
    // Select the best timestamp for WHOIS record deduplication
    // Priority order: changed > updated > expires > registered > date

    // Check for changed date first (most recent change indicator)
    if ($reg.changed and $reg.changed.0) {
        return($lib.time.parse($reg.changed.0, "%Y-%m-%dT%H:%M:%SZ"))
    }

    // Fall back to updated date (modification timestamp)
    if ($reg.updated and $reg.updated.0) {
        return($lib.time.parse($reg.updated.0, "%Y-%m-%dT%H:%M:%SZ"))
    }

    // Fall back to expires date (next best indicator of record state)
    if ($reg.expires and $reg.expires.0) {
        return($lib.time.parse($reg.expires.0, "%Y-%m-%dT%H:%M:%SZ"))
    }

    // Fall back to registered/created date (original creation)
    if ($reg.registered and $reg.registered.0) {
        return($lib.time.parse($reg.registered.0, "%Y-%m-%dT%H:%M:%SZ"))
    }

    // Final fallback to date field (current behavior)
    if ($reg.date) {
        return($lib.time.parse($reg.date, "%Y-%m-%d"))
    }

    // Should not reach here, but return current time as last resort
    return($lib.time.now())
}

function emitDomainRegHistory(data) {
    $srcnode = $getMetaSource()
    for $reg in $data.records.registration {
        // Uses selectBestTimestamp to handle inconsistent WHOIS timestamp data
        $asof = $selectBestTimestamp($reg)
        $created = $lib.time.parse($reg.registered.0, "%Y-%m-%dT%H:%M:%SZ")
        $expires = $lib.time.parse($reg.expires.0, "%Y-%m-%dT%H:%M:%SZ")
        $domain = $reg.domain
        $registrar = $reg.registrar.0
        // create init whois node
        [ inet:whois:rec=($domain, $asof)
            :created=$created
            :expires=$expires
            :registrar=$registrar
        ]
        // conditional on if updated field exists
        if $reg.updated {
            $updated = $lib.time.parse($reg.updated.0, "%Y-%m-%dT%H:%M:%SZ")
            [ :updated = $updated ]
        }
        // Add nameserver relationships
        for $ns in $reg.nameservers {
            [ inet:whois:recns=($ns, $node) ]
        }
    }
    [<(seen)+ { yield $srcnode }]
    | uniq
}

function parseDomainReputation(data, domain) {
    $srcnode = $getMetaSource()

    // Normalize domain and create the node
    ($ok, $norm) = $lib.trycast(inet:fqdn, $domain)
    if ($ok) {
        // Create/update the domain node with reputation properties
        [ inet:fqdn=$norm
            :_validin:reputation_score=$data.score
            :_validin:reputation_verdict=$data.verdict
        ] {
            // Apply reputation tags based on annotations
            for $annotation in $data.annotations {
                if ($annotation.description = "MAGESTIC_MILLION_RANK") {
                    [ +#rep.validin.majestic.1m ]
                } elif ($annotation.description = "TRANCO_TOP_1M_RANK") {
                    [ +#rep.validin.tranco.1m ]
                } elif ($annotation.description = "UMBRELLA_TOP_1M_RANK") {
                    [ +#rep.validin.umbrella.1m ]
                }
            }
        }
    } else {
        if ($lib.debug) {
            $lib.warn(`Failed to cast domain: {$domain}`)
        }
    }

    | uniq |
    [<(seen)+ { yield $srcnode }]
}

// =============================================================================
// PROJECT MANAGEMENT - Project listing, indicator management, resolution
// =============================================================================

function getValidinActiveProject() {
    // see if the user has their own active project set
    $project_guid = $lib.user.vars.get("validin:active_project")
    if ($project_guid) {
        return($project_guid)
    }

    // no user project, check for global
    $project_guid = $lib.globals.get("validin:active_project")
    if ($project_guid) {
        return($project_guid)
    }

    return($lib.false)
}

function setValidinActiveProject(guid, self) {
    // Validate the project GUID exists in our system first
    $project_exists = $lib.false
    proj:project=$guid {
        $project_exists = $lib.true
    }

    if (not $project_exists) {
        $lib.warn(`Project GUID {$guid} not found in Synapse. Run 'ex.validin.project.list' first to sync projects.`)
        return($lib.false)
    }

    if ($self) {
        $lib.user.vars.set("validin:active_project", $guid)
    } else {
        $lib.globals.set("validin:active_project", $guid)
    }
    return($lib.true)
}

function parseProjectList(data) {
    $srcnode = $getMetaSource()

    for ($project_id, $project_info) in $data.projects {
        [proj:project=$project_id
            :_validin:guid=$project_id
            :name=$project_info.details.name
            :type=validin
            :created=$lib.time.fromunix($project_info.details.create_time)
            :desc?=$project_info.details.description
        ]
    }

    | uniq |
    [<(seen)+ { yield $srcnode }]
}

function parseProjectIndicators(data, project_guid) {
    $srcnode = $getMetaSource()

    for $indicator in $data.indicators {
        $indicator_key = $indicator.key
        $key_type = $indicator.key_type
        $added_time = $lib.time.fromunix($indicator.time)

        // Create indicator nodes and link to project via (refs) edges
        // Validates form compatibility before node creation
        if ($key_type = "dom") {
            ($ok, $norm) = $lib.trycast(inet:fqdn, $indicator_key)
            if ($ok) {
                [ inet:fqdn=$norm .seen=$added_time <(refs)+ { proj:project=$project_guid } ]
            }
        } elif ($key_type = "ip4") {
            ($ok, $norm) = $lib.trycast(inet:ipv4, $indicator_key)
            if ($ok) {
                [ inet:ipv4=$norm .seen=$added_time <(refs)+ { proj:project=$project_guid } ]
            }
        } elif ($key_type = "ip6") {
            ($ok, $norm) = $lib.trycast(inet:ipv6, $indicator_key)
            if ($ok) {
                [ inet:ipv6=$norm .seen=$added_time <(refs)+ { proj:project=$project_guid } ]
            }
        } elif ($key_type = "hash") {
            // Try different hash types
            ($ok, $norm) = $lib.trycast(hash:md5, $indicator_key)
            if ($ok) {
                [ hash:md5=$norm .seen=$added_time <(refs)+ { proj:project=$project_guid } ]
            } else {
                ($ok, $norm) = $lib.trycast(hash:sha1, $indicator_key)
                if ($ok) {
                    [ hash:sha1=$norm .seen=$added_time <(refs)+ { proj:project=$project_guid } ]
                } else {
                    ($ok, $norm) = $lib.trycast(hash:sha256, $indicator_key)
                    if ($ok) {
                        [ hash:sha256=$norm .seen=$added_time <(refs)+ { proj:project=$project_guid } ]
                    }
                }
            }
        } else {
            $debugPrint("Threat", `Failed to create node for indicator: {$indicator_key} (type: {$key_type})`)
        }
    }

    | uniq |
    [<(seen)+ { yield $srcnode }]
}

function resolveProjectIdentifier(identifier) {
    /*
    Resolve project identifier (name or GUID) to project node and Validin GUID
    Returns: (success, project_guid, validin_guid)
    */

    // Try as project name first
    proj:project +:name=$identifier {
        $project_guid = $node.repr()
        $validin_guid = $node.props.get("_validin:guid")
        if ($validin_guid) {
            return(($lib.true, $project_guid, $validin_guid))
        }
    }

    // Try as project GUID
    proj:project=$identifier {
        $project_guid = $node.repr()
        $validin_guid = $node.props.get("_validin:guid")
        if ($validin_guid) {
            return(($lib.true, $project_guid, $validin_guid))
        }
    }

    // No project found
    return(($lib.false, $lib.null, $lib.null))
}

// =============================================================================
// THREAT INTELLIGENCE - Campaign indicators, threat group IOCs
// =============================================================================

function parseThreatGroupIndicators(data, threat_key, limit=0) {
    $srcnode = $getMetaSource()
    $tagPrefix = $getTagPrefix()
    $count = 0

    for $indicator in $data.indicators {
        // Check limit if specified
        if ($limit and $count >= $limit) {
            $debugPrint("Threat", `Reached limit of {$limit} indicators, stopping processing`)
            break
        }

        $indicator_key = $indicator.key
        $key_type = $indicator.key_type
        $added_time = $lib.time.fromunix($indicator.date_added)

        // Create indicator nodes and tag them with threat group
        if ($key_type = "dom") {
            ($ok, $norm) = $lib.trycast(inet:fqdn, $indicator_key)
            if ($ok) {
                [ inet:fqdn=$norm .seen=$added_time ] { [ +#$lib.str.concat($tagPrefix, ".", $threat_key) ] }
                $count = ($count + 1)
            }
        } elif ($key_type = "ip4") {
            ($ok, $norm) = $lib.trycast(inet:ipv4, $indicator_key)
            if ($ok) {
                [ inet:ipv4=$norm .seen=$added_time ] { [ +#$lib.str.concat($tagPrefix, ".", $threat_key) ] }
                $count = ($count + 1)
            }
        } elif ($key_type = "ip6") {
            ($ok, $norm) = $lib.trycast(inet:ipv6, $indicator_key)
            if ($ok) {
                [ inet:ipv6=$norm .seen=$added_time ] { [ +#$lib.str.concat($tagPrefix, ".", $threat_key) ] }
                $count = ($count + 1)
            }
        } else {
            $debugPrint("Threat", `Failed to create node for indicator: {$indicator_key} (type: {$key_type})`)
        }
    }

    $debugPrint("Threat", `Processed {$count} threat group indicators for {$threat_key}`)

    | uniq |
    [<(seen)+ { yield $srcnode }]
}